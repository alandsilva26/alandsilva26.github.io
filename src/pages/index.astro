---
import Header from '../layouts/Header.astro';

import sfitAppBanner from '../assets/images/sfit-app/final.png';

import '../styles/pages/projects.scss';
import '../styles/pages/home.scss';
import Layout from '../layouts/Layout.astro';
import { ProjectsPreview } from '../components/ProjectsPreview';
---

<Layout title="Home">
    <Header>
        <div class="header--home" id="homeHeader">
            <div class="header--home-overlay"></div>
            <div class="header--home-overlay"></div>
            <div class="header--home-overlay"></div>
            <div class="header--home-overlay"></div>
            <div class="container">
                <div class="row">
                    <div class="col-md-6 primary-purple">
                        <div>Hello, I'm</div>
                        <h1>Alan Dsilva</h1>
                        <p class="pt-1">an aspiring Software Developer.</p>
                    </div>
                </div>
            </div>
            <!-- <SocialChips /> -->
        </div>
    </Header>
    <div class="home">
        <div class="px-5 pt-5">
            <h2>
                <b>Notable Projects</b>
            </h2>
        </div>
        <div class="project__sfit-app">
            <div class="container-fluid">
                <div class="row shadow">
                    <div class="col col-12 col-sm-12 col-md-6 col__left">
                        <p class="project__subtitle">
                            <a
                                href="https://github.com/alandsilva26?tab=projects"
                            >
                                Flutter Project: March 2020 - July 2020
                            </a>
                        </p>
                        <h2 class="project__title">SFIT Android App</h2>
                        <hr />
                        <div class="project__description">
                            <b>App features</b>
                            <ul>
                                <li>Track attendance</li>
                                <li>View news and get notified</li>
                                <li>View exam results</li>
                                <li>
                                    View and manage issued books from library
                                </li>
                                <li>
                                    View and answer polls directly through app
                                </li>
                                <li>
                                    Allows sign in for Parents, Teachers and
                                    Students.
                                </li>
                            </ul>
                        </div>
                        <a
                            class="playstore__button"
                            href="https://play.google.com/store/apps/details?id=org.sfit.sfitapp&pcampaignid=pcampaignidMKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1"
                        >
                            <img
                                class="img-fluid"
                                alt="Get it on Google Play"
                                src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png"
                            />
                        </a>
                    </div>
                    <div class="col col-12 col-sm-12 col-md-6 col__right">
                        <img
                            class="project__image img-fluid"
                            src={sfitAppBanner.src}
                            alt=""
                        />
                    </div>
                </div>
            </div>
        </div>
        <section class="home--featured-projects">
            <div class="projects--background-image"></div>
            <div class="background-color"></div>
            <div class="container">
                <div class="row heading-row justify-content-between">
                    <div class="col">
                        <div class="text-start featured-projects--cell">
                            All Projects
                        </div>
                    </div>
                    <div class="col">
                        <div class="text-end featured-projects--cell">
                            <a href="projects">View all</a>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <ProjectsPreview client:load />
                </div>
            </div>
        </section>
    </div>
</Layout>

<script>
    const handleScroll = () => {
        const homeHeader = document.getElementById('homeHeader');
        if (!homeHeader) {
            return;
        }
        const offset = window.scrollY;
        const base = homeHeader.children as HTMLCollectionOf<HTMLElement>;

        base[0].style.backgroundPositionY = offset * 0.2 + 'px';
        base[1].style.backgroundPositionX = offset * 0.05 + 'px';

        base[1].style.backgroundPositionY = offset * 0.3 + 'px';

        base[2].style.backgroundPositionY = offset * 0.4 + 'px';
        base[2].style.backgroundPositionX = -offset * 0.03 + 'px';

        base[3].style.backgroundPositionY = offset * 0.3 + 'px';
    };

    window.addEventListener('scroll', handleScroll);
</script>
